{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "start:experiment": "HOST=0.0.0.0 PORT=9376 node ./dist/index.js",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "test:unit": "node --test dist/test/*.test.js",
    "test:llm": "pnpm run build && RUN_LLM_CONNECTION_TEST=1 node --test dist/test/llmConnection.test.js",
    "preeval:llm": "pnpm run build",
    "eval:llm": "node dist/evaluation/llmBenchmark/cli.js",
    "clean": "rm -rf ./compilations/* && rm -rf ./mockedFiles/*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.6.0-dev.20240730"
  },
  "type": "module"
}
