{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "circomlib",
    "compilations",
    "mockedFiles",
    "wrappers"
  ]
}
